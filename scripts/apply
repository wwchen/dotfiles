#!/bin/bash
# `just apply`: show what applying this repo would do, ask once, then do it.
#   scripts/apply        plan, confirm, apply
#   scripts/apply -y     plan, apply without asking
#
# The plan lists files chezmoi would create/update/delete, and asks each setup script
# that would run (home/run_*) what it would do, by running it with DOTFILES_PLAN=1
# (scripts print their plan and exit without changing anything). The apply then runs
# with DOTFILES_YES=1 so the scripts don't ask again.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
YES=0
[[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && YES=1
cz=(chezmoi --source "$ROOT")

bold=$'\e[1m'; dim=$'\e[2m'; reset=$'\e[0m'
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

"${cz[@]}" status --exclude dirs > "$tmp/status"
todo=0

echo "${bold}Files${reset}"
while IFS= read -r line; do
  code="${line:1:1}"; path="${line:3}"
  [[ "$code" == R ]] && continue
  case "$code" in A) verb=create ;; M) verb=update ;; D) verb=delete ;; *) verb=change ;; esac
  printf '  %-7s ~/%s\n' "$verb" "$path"
  todo=1
done < "$tmp/status"
(( todo )) || echo "  ${dim}no changes${reset}"

echo "${bold}Setup${reset}"
planned=0
while IFS= read -r line; do
  [[ "${line:1:1}" == R ]] || continue
  name="${line:3}"
  src=("$ROOT"/home/run_*"$name".tmpl)
  [[ -f "${src[0]}" ]] || { echo "  run $name"; todo=1; planned=1; continue; }
  "${cz[@]}" execute-template < "${src[0]}" > "$tmp/script"
  out="$(DOTFILES_PLAN=1 bash "$tmp/script" </dev/null 2>&1 || true)"
  if [[ -n "$out" ]]; then
    while IFS= read -r l; do echo "  $l"; done <<<"$out"
    todo=1; planned=1
  fi
done < "$tmp/status"
(( planned )) || echo "  ${dim}nothing to do${reset}"

if (( ! todo )); then
  echo; echo "Nothing to apply."
  exit 0
fi

echo
if (( ! YES )); then
  if ! { : </dev/tty; } 2>/dev/null; then
    echo "No terminal to confirm in; run 'just apply -y' to apply without asking." >&2
    exit 1
  fi
  while true; do
    read -r -p "Apply? [y/N, d = show file diff] " ans </dev/tty || ans=n
    case "$ans" in
      y|Y|yes) break ;;
      d|D) "${cz[@]}" diff --exclude scripts ;;
      *) echo "Nothing changed."; exit 0 ;;
    esac
  done
fi

DOTFILES_YES=1 "${cz[@]}" apply -v
