#!/bin/bash
# iTerm2 app-level settings. The profile itself is the Dynamic Profile in
# ~/Library/Application Support/iTerm2/DynamicProfiles/wc.json (also managed by chezmoi).
# Re-runs when this script or the profile changes:
#   profile {{ include "Library/Application Support/iTerm2/DynamicProfiles/wc.json" | sha256sum }}
set -euo pipefail
{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{- end }}

if [[ -n "${DOTFILES_PLAN:-}" ]]; then
  echo "iTerm2: make the 'wc' profile the default; turn off pane dimming and click-to-select"
  exit 0
fi

d() { defaults write com.googlecode.iterm2 "$@"; }

# Make the managed profile the default for new windows/tabs.
d "Default Bookmark Guid" -string "B5E1D3A0-7C7E-4B8E-9D55-5C1F0E6A2E01"
# Appearance > Dimming > don't dim inactive split panes
d DimInactiveSplitPanes -bool false
# General > Selection > clicking on a command does not select it
d ClickToSelectCommand -bool false

if pgrep -xq iTerm2; then
  echo "iTerm2 is running: quit and reopen it to pick up app-level settings."
fi
