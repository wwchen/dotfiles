#!/bin/bash
# ~/.config/starship.toml is generated from a built-in Starship preset, not tracked.
# To switch: change PRESET (options: `starship preset --list`), then `just apply`.
# Runs on every apply but only writes when the file differs from the preset, and never fails
# the apply (a failure is reported and retried next time).
set -uo pipefail
PRESET="nerd-font-symbols"   # needs a Nerd Font (Brewfile.core: font-fira-code-nerd-font)
TARGET="$HOME/.config/starship.toml"

{{ if eq .chezmoi.os "darwin" -}}
if [[ -x /opt/homebrew/bin/brew ]]; then eval "$(/opt/homebrew/bin/brew shellenv bash)"; fi
{{- end }}

if ! command -v starship >/dev/null; then
  if [[ -n "${DOTFILES_PLAN:-}" ]]; then
    echo "starship: install it, then write ~/.config/starship.toml from the '$PRESET' preset"
    exit 0
  fi
  brew install starship || { echo "starship: install failed; will retry on the next apply" >&2; exit 0; }
fi

want="$(starship preset "$PRESET" 2>/dev/null)" || { echo "starship: no preset named '$PRESET'" >&2; exit 0; }
if [[ -f "$TARGET" && "$(cat "$TARGET")" == "$want" ]]; then
  exit 0
fi
if [[ -n "${DOTFILES_PLAN:-}" ]]; then
  echo "starship: write ~/.config/starship.toml from the '$PRESET' preset"
  exit 0
fi
mkdir -p "$(dirname "$TARGET")"
if printf '%s\n' "$want" > "$TARGET"; then
  echo "starship: applied preset $PRESET"
else
  echo "starship: couldn't write $TARGET; will retry on the next apply" >&2
fi
exit 0
