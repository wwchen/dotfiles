{{- if contains "brew \"starship\"" (includeTemplate "brew-listed" .) -}}
#!/bin/bash
# ~/.config/starship.toml from a built-in preset (`starship preset --list`).
# Reruns once starship is installed: {{ lookPath "starship" }}
set -uo pipefail
PRESET="nerd-font-symbols"   # needs a Nerd Font
TARGET="$HOME/.config/starship.toml"

{{ if eq .chezmoi.os "darwin" -}}
if [[ -x /opt/homebrew/bin/brew ]]; then eval "$(/opt/homebrew/bin/brew shellenv bash)"; fi
{{- end }}

if ! command -v starship >/dev/null; then
  if [[ -n "${DOTFILES_PLAN:-}" ]]; then
    echo "starship: write ~/.config/starship.toml from the '$PRESET' preset (once the brew step installs starship)"
  else
    echo "starship: not installed yet, so no preset; the apply after it's installed writes it"
  fi
  exit 0
fi

want="$(starship preset "$PRESET" 2>/dev/null)" || { echo "starship: no preset named '$PRESET'" >&2; exit 0; }
if [[ -f "$TARGET" && "$(cat "$TARGET")" == "$want" ]]; then
  exit 0
fi
if [[ -n "${DOTFILES_PLAN:-}" ]]; then
  echo "starship: write ~/.config/starship.toml from the '$PRESET' preset"
  exit 0
fi
mkdir -p "$(dirname "$TARGET")"
if printf '%s\n' "$want" > "$TARGET"; then
  echo "starship: applied preset $PRESET"
else
  echo "starship: couldn't write $TARGET" >&2
fi
exit 0
{{ end -}}
