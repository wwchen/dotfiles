# Managed by chezmoi — edit in ~/code/wwchen/dotfiles/home/dot_zshrc.tmpl, then `just apply`.
# Machine-specific or secret bits go in ~/.zshrc.local (not tracked), and so does anything an
# installer outside this repo wants to add here (e.g. LM Studio's PATH line). A tool set up
# below is one this repo installs, and only if it's actually there.

{{ if eq .chezmoi.os "darwin" -}}
# Login shells get this from ~/.zprofile (Homebrew's installer adds it); non-login ones
# (some editor terminals) don't.
[[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"
{{- end }}

# oh-my-zsh: the setup step in home/.chezmoidata/steps.yaml
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""            # prompt comes from starship
plugins=(git)
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

alias reload='source ~/.zshrc'
alias zshrc='chezmoi edit --apply ~/.zshrc && reload'

setopt no_share_history
setopt no_nomatch
setopt no_extended_glob
setopt no_glob

{{ if eq .machine "work" -}}
# --- work machine ---
{{- end }}

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# starship prompt: installed by the starship step (run_after_30); oh-my-zsh's theme is off above
command -v starship >/dev/null && eval "$(starship init zsh)"
