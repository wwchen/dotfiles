# Core: every Mac. Installed by `just apply`, with the other groups: Brewfile.apps (every
# Mac), Brewfile.dev (if you said yes at `chezmoi init`), Brewfile.<machine type>.
# Sync with what's actually installed: `just brew-sync`.

# --- shell & CLI ---
brew "chezmoi"
brew "fzf"
brew "gh"
brew "jq"
brew "just"
brew "mas"
brew "starship"
brew "zsh-autosuggestions"

# --- passwords ---
cask "1password"
cask "1password-cli"

# --- terminal ---
cask "iterm2"
cask "font-fira-code-nerd-font"
